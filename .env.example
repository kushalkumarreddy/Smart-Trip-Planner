# =========================================================
# VoyageCraft Environment Variables Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit the real .env file into Git.
# =========================================================

# Application Profile & Port
SPRING_PROFILES_ACTIVE=prod
PORT=8080

# Database Configuration (MySQL 8.0+)
# Option A: Individual connection properties
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trip_planner
DB_USERNAME=voyagecraft_user
DB_PASSWORD=your_secure_password_here

# Option B: Complete JDBC URL (Overrides Option A if supplied)
# SPRING_DATASOURCE_URL=jdbc:mysql://your-remote-host:3306/trip_planner?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Connection Pool Tuning (Optional)
DB_POOL_MAX=10
DB_POOL_MIN_IDLE=4

# Google Maps Platform API Key (Optional)
# If provided, enables live Google Directions and Google Places APIs
# Required APIs: Maps JavaScript API, Places API (New), Directions API, Distance Matrix API, Geocoding API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_MAPS_ENABLED=true

# AI Itinerary Generator Service Key (Optional)
AI_API_KEY=your_ai_api_key_here

# OpenStreetMap / Overpass Smart Stops along Route (Optional)
SMARTSTOPS_OVERPASS_ENABLED=true
