# =========================================================
# VoyageCraft Environment Configuration Template
# Copy this file to .env or export these variables in your deployment environment.
# Never commit real production secrets or API keys to source control.
# =========================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=trip_planner
DB_USERNAME=root
DB_PASSWORD=root

# Optional Google Maps Platform API Key
# If provided, VoyageCraft connects to Google Places & Directions APIs.
# If omitted or left blank, VoyageCraft automatically uses the built-in
# high-precision highway routing engine (OSRM) and Photon geocoding.
#
# Required Google Cloud APIs if enabled:
# 1. Maps JavaScript API
# 2. Places API (New) / Places API
# 3. Directions API
# 4. Distance Matrix API
# 5. Geocoding API
GOOGLE_MAPS_API_KEY=

# Spring Boot Profiles (e.g. dev, prod)
SPRING_PROFILES_ACTIVE=dev
